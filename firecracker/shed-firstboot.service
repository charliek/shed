[Unit]
Description=Shed first-boot identity setup
DefaultDependencies=no
After=systemd-remount-fs.service local-fs.target
# Ordered ONLY before ssh.service. The hard invariant: per-shed SSH host
# keys must be regenerated before sshd starts, or every shed would serve the
# identical baked-in host keys. We deliberately do NOT order before
# sysinit.target / shed-agent.service / network-setup.service: ssh-keygen
# blocks on early-boot crng init (the guest has no hwrng), and gating all of
# boot on it delayed shed-agent — which `shed create` waits on — by the full
# firstboot duration. Hostname is still set before the keys here (key-comment
# correctness); it may now land just after journald starts, so the first few
# log lines can carry the transient hostname (cosmetic).
Before=ssh.service
Requires=local-fs.target
# No ConditionVirtualization=vm: Docker-built rootfs makes systemd-detect-virt
# return "docker" even when booted as a VM. The shed-firstboot binary itself
# short-circuits when /proc/cmdline has no shed.name= (e.g., rootfs run
# outside of shed for debugging), so the systemd-side gate is redundant.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/shed-firstboot
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
