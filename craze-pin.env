# The craze pins (plan 025). Two pins, two jobs.
# CRAZE_TEST_SHA: a MERGED craze main commit (never a branch head). Both CIs build craze,
#   craze-fake-host and craze-fake-agent here for the hermetic tests.
# CRAZE_RELEASE: the craze release the shed images bake (bare X.Y.Z), or empty before the bake.
# At a shed release that ships `server`, CRAZE_TEST_SHA must equal CRAZE_RELEASE's tag commit
# (scripts/release/check-craze-pin.sh, run by release-plan.sh).
CRAZE_TEST_SHA=8d5676c34a34b12d496b1e3d83c058fe7ae5775b
CRAZE_RELEASE=0.1.0
