      "expected": {"connected": true, "mode": "local-keys", "key_count": 3}
    },
    {
      "name": "agent-forward-0",
      "input": {"mode": "agent-forward", "key_count": 0},
      "expected": {"connected": true, "mode": "agent-forward", "key_count": 0}
    }
