    "socket_path": "<dir>/host-agent.sock"
  },
  "config_path": "<config_path>",
  "gate_namespaces": [
    "ssh-agent"
  ],
  "machine": {
    "id": "<machine_id>",
    "name": "<machine_name>"
  },
  "pid": "<pid>",
  "policies": {
    "aws-credentials": "approve-all",
    "docker-credentials": "deny-all",
    "ssh-agent": "shed-desktop"
  },
  "schema": 1,
  "servers": [],
  "ssh": {
    "allow_users": [
      "git"
    ],
    "key_filter": false,
    "mode": "local-keys"
  },
  "started_at": "<ts>",
  "version": "<version>",
  "written_at": "<ts>"
}
