{
  "name": "call-unauthorized-twice",
  "description": "401, then 401 again after a new token: source_refused.",
  "request": "create-repo",
  "calls": [
    {
      "status": 401,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store",
        "WWW-Authenticate": "Bearer error=\"invalid_token\""
      },
      "body": {
        "error": {
          "code": "invalid_token",
          "message": "fixed text"
        }
      }
    },
    {
      "status": 401,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store",
        "WWW-Authenticate": "Bearer error=\"invalid_token\""
      },
      "body": {
        "error": {
          "code": "invalid_token",
          "message": "fixed text"
        }
      }
    }
  ],
  "expect": {
    "result": "failed",
    "reason": "source_refused"
  }
}
