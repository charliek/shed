{
  "name": "token-deliveries-not-allowed",
  "description": "The service no longer lets srv-a ask for deliveries: the delivery token request is 400 invalid_scope (for the server, not_applicable), and the assertion is not spent.",
  "before": [
    {
      "deliveries.deny": "srv-a"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=deliveries%3Arequest"
  },
  "response": {
    "status": 400,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": "invalid_scope",
      "error_description": "{{description}}"
    }
  }
}
