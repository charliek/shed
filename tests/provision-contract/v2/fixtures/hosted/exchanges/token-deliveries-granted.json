{
  "name": "token-deliveries-granted",
  "description": "A live server (srv-a) that may ask for deliveries asks for a token with scope=deliveries:request: a ten-minute token whose body names the scope deliveries:request.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=deliveries%3Arequest"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{delivery_token}}",
      "expires_in": 600,
      "scope": "deliveries:request",
      "token_type": "bearer"
    }
  }
}
