{
  "name": "deliveries-payload-too-large",
  "description": "A body of 64 KiB and one byte: 413 PAYLOAD_TOO_LARGE (for the server, source_refused).",
  "before": [
    {
      "sources.set": "ada"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=deliveries%3Arequest"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{delivery_token}}",
      "expires_in": 600,
      "scope": "deliveries:request",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/deliveries",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{delivery_token}}"
        },
        "body_bytes": 65537
      },
      "response": {
        "status": 413,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": {
            "code": "PAYLOAD_TOO_LARGE",
            "message": "{{message}}"
          }
        }
      }
    }
  ]
}
