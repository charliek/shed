{
  "name": "token-compute-disabled-server",
  "description": "The disabled server srv-b asks for compute:manage: 401 invalid_client, as for every scope.",
  "assertion": {
    "key": "server-p256",
    "client_id": "srv_0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
  },
  "response": {
    "status": 401,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": "invalid_client",
      "error_description": "{{description}}"
    }
  }
}
