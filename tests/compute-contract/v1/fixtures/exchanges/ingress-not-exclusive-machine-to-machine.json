{
  "name": "ingress-not-exclusive-machine-to-machine",
  "description": "exclusive is true while every clause holds; once one machine can reach another (clause 2), a read and a write answer exclusive: false.",
  "before": [
    {
      "compute.allow": "srv-a"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
