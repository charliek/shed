        "path": "/v1/compute/ingress",
        "headers": {
          "Authorization": "Bearer {{compute_token}}"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "sources": [
            "203.0.113.0/24",
            "2001:db8:5::/48"
          ],
          "exclusive": false,
          "applied_at": "2026-11-16T06:00:00Z"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v1/compute/ingress",
