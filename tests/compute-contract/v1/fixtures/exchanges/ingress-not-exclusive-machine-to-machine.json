          "Content-Type": "application/json"
        },
        "body": {
          "request_id": "00000000-0000-4000-8000-000000000001",
          "sources": [
            "203.0.113.0/24",
            "2001:db8:5::/48"
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "sources": [
            "203.0.113.0/24",
            "2001:db8:5::/48"
          ],
          "exclusive": true,
          "applied_at": "2026-11-16T06:00:00Z"
        }
      }
    },
