{
  "name": "ingress-too-wide",
  "description": "A source wider than the service allows (IPv4 /23, IPv6 /32): 422 INGRESS_TOO_WIDE.",
  "before": [
    {
      "compute.allow": "srv-a"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{compute_token}}",
      "expires_in": 600,
      "scope": "compute:manage",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "request": {
        "method": "PUT",
        "path": "/v1/compute/ingress",
        "headers": {
          "Authorization": "Bearer {{compute_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "request_id": "00000000-0000-4000-8000-000000000001",
          "sources": [
            "192.0.2.0/23"
          ]
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": {
            "code": "INGRESS_TOO_WIDE",
            "message": "{{message}}"
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v1/compute/ingress",
        "headers": {
          "Authorization": "Bearer {{compute_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "request_id": "00000000-0000-4000-8000-000000000002",
          "sources": [
            "2001:db8::/32"
          ]
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": {
            "code": "INGRESS_TOO_WIDE",
            "message": "{{message}}"
          }
        }
      }
    }
  ]
}
