{
  "name": "compute-grant-removed",
  "description": "srv-a gets a compute token; the service then stops letting it manage compute: the token it still holds gets 403 INSUFFICIENT_SCOPE (the grant is read on every call).",
  "before": [
    {
      "compute.allow": "srv-a"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{compute_token}}",
      "expires_in": 600,
      "scope": "compute:manage",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "before": [
        {
          "compute.deny": "srv-a"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/v1/compute/catalog",
        "headers": {
          "Authorization": "Bearer {{compute_token}}"
        },
        "body": null
      },
      "response": {
        "status": 403,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": {
            "code": "INSUFFICIENT_SCOPE",
            "message": "{{message}}"
          }
        }
      }
    }
  ]
}
