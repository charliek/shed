{
  "name": "create-client-unknown",
  "description": "A client name not registered for srv-a: 403 CLIENT_UNKNOWN.",
  "before": [
    {
      "compute.allow": "srv-a"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{compute_token}}",
      "expires_in": 600,
      "scope": "compute:manage",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "request": {
        "method": "PUT",
        "path": "/v1/compute/machines/q6c3g4ymb5m2dkxwe7kyz5hhzu",
        "headers": {
          "Authorization": "Bearer {{compute_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "request_id": "00000000-0000-4000-8000-000000000001",
          "name": "ci-run-1",
          "client": "ci",
          "size": "standard",
          "image": "default",
          "labels": {},
          "authorized_keys": [
            "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL9jM32vCKELuuzbFDA+wh9kao37z7pApfvNTWB0bsX5"
          ],
          "spec": "spec-v1 layout=1 repo=example/widgets",
          "access_kinds": [
            "ssh"
          ],
          "lease_s": 7200
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": {
            "code": "CLIENT_UNKNOWN",
            "message": "{{message}}"
          }
        }
      }
    }
  ]
}
