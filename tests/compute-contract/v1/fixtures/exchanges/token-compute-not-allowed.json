{
  "name": "token-compute-not-allowed",
  "description": "srv-a, which the service has not let manage compute (the grant is off by default), asks for compute:manage: 400 invalid_scope, and the assertion is not spent: once the grant is on, the same assertion, sent again byte for byte, is accepted.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
  },
  "response": {
    "status": 400,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": "invalid_scope",
      "error_description": "{{description}}"
    }
  },
  "then": [
    {
      "before": [
        {
          "compute.allow": "srv-a"
        }
      ],
      "assertion": {
        "reuse": true
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": "no-cache",
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "access_token": "{{compute_token}}",
          "expires_in": 600,
          "scope": "compute:manage",
          "token_type": "bearer"
        }
      }
    }
  ]
}
