{
  "name": "create-client",
  "description": "A registered client's machine (ci, on srv-a) with lease_s 7200 and the large size: its lease ends and is capped at creation plus 7200 s, it is not extendable and has no presets; the disk is the size's default.",
  "before": [
    {
      "compute.allow": "srv-a"
    },
    {
      "client.register": [
        "srv-a",
        "ci"
      ]
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=compute%3Amanage"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{compute_token}}",
      "expires_in": 600,
      "scope": "compute:manage",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "request": {
        "method": "PUT",
        "path": "/v1/compute/machines/q6c3g4ymb5m2dkxwe7kyz5hhzu",
        "headers": {
          "Authorization": "Bearer {{compute_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "request_id": "00000000-0000-4000-8000-000000000001",
          "name": "ci-run-1",
          "client": "ci",
          "size": "large",
          "image": "default",
          "labels": {},
          "authorized_keys": [
            "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL9jM32vCKELuuzbFDA+wh9kao37z7pApfvNTWB0bsX5"
          ],
          "spec": "spec-v1 layout=1 repo=example/widgets",
          "access_kinds": [
            "ssh"
          ],
          "lease_s": 7200
        }
      },
      "response": {
        "status": 202,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "machine": {
            "shed_id": "q6c3g4ymb5m2dkxwe7kyz5hhzu",
            "name": "ci-run-1",
            "server": "srv-a",
            "user": null,
            "client": "ci",
            "state": "creating",
            "size": {
              "name": "large",
              "cpus": 8,
              "memory_mb": 32768,
              "arch": "amd64"
            },
            "disk_gb": 100,
            "image": {
              "requested": "default",
              "resolved": "shed-remote-full-v1-0-0-20261101-000000"
            },
            "provider": "ref",
            "created_at": "2026-11-16T06:00:00Z",
            "started_at": null,
            "stopped_at": null,
            "lease": {
              "expires_at": "2026-11-16T08:00:00Z",
              "max_expires_at": "2026-11-16T08:00:00Z",
              "extendable": false,
              "presets_h": []
            },
            "access": [],
            "labels": {},
            "spec": "spec-v1 layout=1 repo=example/widgets"
          },
          "operation": "{{operation_1}}"
        }
      }
    }
  ]
}
