{
  "name": "code-not-found",
  "description": "NOT_FOUND at 404: a refusal of kind ErrNotFound.",
  "call": "get",
  "replies": [
    {
      "status": 404,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store"
      },
      "body": {
        "error": {
          "code": "NOT_FOUND",
          "message": "words for people, never read"
        }
      }
    }
  ],
  "expect": {
    "result": "refused",
    "code": "NOT_FOUND",
    "kind": "ErrNotFound"
  }
}
