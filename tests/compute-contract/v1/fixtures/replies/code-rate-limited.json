{
  "name": "code-rate-limited",
  "description": "RATE_LIMITED at 429: wait for Retry-After (capped at 30 s), then try again inside the deadline.",
  "call": "get",
  "replies": [
    {
      "status": 429,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store",
        "Retry-After": "7"
      },
      "body": {
        "error": {
          "code": "RATE_LIMITED",
          "message": "words for people, never read"
        }
      }
    }
  ],
  "expect": {
    "result": "retry",
    "retry_after_s": 7
  }
}
