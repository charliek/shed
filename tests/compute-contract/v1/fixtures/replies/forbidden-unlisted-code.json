{
  "name": "forbidden-unlisted-code",
  "description": "403 with a code outside the list: the 403 default, COMPUTE_DENIED.",
  "call": "get",
  "replies": [
    {
      "status": 403,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store"
      },
      "body": {
        "error": {
          "code": "SOMETHING_NEW",
          "message": "words for people, never read"
        }
      }
    }
  ],
  "expect": {
    "result": "refused",
    "code": "COMPUTE_DENIED",
    "kind": "ErrDenied"
  }
}
