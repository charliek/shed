{
  "name": "retry-after-over-cap",
  "description": "429 with Retry-After '60': wait 30 s.",
  "call": "get",
  "replies": [
    {
      "status": 429,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store",
        "Retry-After": "60"
      },
      "body": {
        "error": {
          "code": "RATE_LIMITED",
          "message": "words for people, never read"
        }
      }
    }
  ],
  "expect": {
    "result": "retry",
    "retry_after_s": 30
  }
}
