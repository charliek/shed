{
  "absolute-bin": [
    "-c",
    "/home/charliek/.local/bin/probe.sh"
  ],
  "backslash": [
    "-c",
    "a\\b\\\\c"
  ],
  "command-substitution": [
    "-c",
    "`id` and $(id)"
  ],
  "dollar-var": [
    "-c",
    "$HOME and ${PATH}"
  ],
  "double-quote": [
    "-c",
    "say \"hi\""
  ],
  "empty-string": [
    "-c",
    ""
  ],
  "flag-with-value": [
    "-c",
    "find /tmp -maxdepth 1 -name gx-remote.sock"
  ],
  "gx-probe": [
    "-c",
    "h=${GROK_HOME:-$HOME/.grok}\nfor f in \"$h\"/gx-remote*.json; do\n  [ -f \"$f\" ] || continue\n  cat \"$f\" 2>/dev/null\n  printf \"\\n---\\n\"\ndone\nprintf \"===token===\\n\"\nt=\"$h/gx-remote.token\"\nfind \"$t\" -prune -type f -perm 0600 -user \"$(id -un)\" -exec cat {} \\; 2>/dev/null\nexit 0\n"
  ],
  "leading-dash": [
    "-c",
    "--not-a-flag"
  ],
  "many-args": [
    "-c",
    "h=$HOME/.myagent\nfor f in \"$h\"/session-*.json; do\n  [ -f \"$f\" ] || continue\n  cat \"$f\"\ndone\necho 'done'\n"
  ],
  "newline": [
    "-c",
    "line one\nline two"
  ],
  "plain": [
    "-c",
    "echo hi"
  ],
  "redirection-and-glob": [
    "-c",
    "> out < in *.txt ?[a-z]"
  ],
  "shell-metacharacters": [
    "-c",
    "abc; touch /tmp/pwn && echo no | cat"
  ],
  "single-quote": [
    "-c",
    "it's mine"
  ],
  "space-in-value": [
    "-c",
    "my session"
  ],
  "tab-and-spaces": [
    "-c",
    "a\tb   c"
  ],
  "tilde": [
    "-c",
    "~/projects"
  ],
  "unicode": [
    "-c",
    "café 日本語 🦉"
  ]
}
