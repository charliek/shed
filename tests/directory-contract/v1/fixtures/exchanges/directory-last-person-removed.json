{
  "name": "directory-last-person-removed",
  "description": "Every user removed: the directory is users: [], a valid and authoritative answer. It means nobody but the server's own local admins may log in, never \"no user list\".",
  "before": [
    {
      "users.remove": "ada"
    },
    {
      "users.remove": "linus"
    },
    {
      "users.remove": "turing"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{access_token}}",
      "expires_in": 600,
      "scope": "directory:read",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/directory",
        "headers": {
          "Authorization": "Bearer {{access_token}}"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "contract": 1,
          "generated_at": "2026-11-16T06:00:00Z",
          "organization": "example",
          "rules": {
            "version": 0
          },
          "users": [],
          "version": "{{version}}"
        }
      }
    }
  ]
