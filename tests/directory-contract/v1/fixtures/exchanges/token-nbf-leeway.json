{
  "name": "token-nbf-leeway",
  "description": "Fresh assertions carrying nbf ahead of the service's clock t (nbf <= t + 30 s): nbf = t + 30 s is accepted, nbf = t + 31 s is invalid_client.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
    "nbf_offset": 30
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{access_token}}",
      "expires_in": 600,
      "scope": "directory:read",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "assertion": {
        "key": "server-ed25519",
        "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
        "nbf_offset": 31
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 401,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": "invalid_client",
          "error_description": "{{description}}"
        }
      }
    }
  ]
}
