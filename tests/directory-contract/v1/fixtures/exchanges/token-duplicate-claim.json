{
  "name": "token-duplicate-claim",
  "description": "An assertion whose claims name iss twice, with the same value both times: no JSON member may be named twice, so invalid_client however a parser would have read it.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
    "duplicate_claim": "iss"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 401,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": "invalid_client",
      "error_description": "{{description}}"
    }
  }
}
