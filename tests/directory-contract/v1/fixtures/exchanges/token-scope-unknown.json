{
  "name": "token-scope-unknown",
  "description": "The live server (srv-a) asks for a scope it lacks, scope=example:none: 400 invalid_scope, and the assertion is not spent. The same assertion, sent again byte for byte without the scope, is then accepted.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}&scope=example%3Anone"
  },
  "response": {
    "status": 400,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": "invalid_scope",
      "error_description": "{{description}}"
    }
  },
  "then": [
    {
      "assertion": {
        "reuse": true
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": "no-cache",
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "access_token": "{{access_token}}",
          "expires_in": 600,
          "scope": "directory:read",
          "token_type": "bearer"
        }
      }
    }
  ]
}
