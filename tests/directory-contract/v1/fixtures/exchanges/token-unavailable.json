{
  "name": "token-unavailable",
  "description": "The service cannot look the server up (every lookup fails, as in a storage outage): 503 server_error, and nothing was spent, so a fresh assertion after the outage succeeds. A failed refresh: retry after 15 minutes.",
  "before": [
    {
      "lookups.fail": true
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 503,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": "server_error",
      "error_description": "{{description}}"
    }
  }
}
