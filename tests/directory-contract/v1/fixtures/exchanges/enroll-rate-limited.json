{
  "name": "enroll-rate-limited",
  "description": "The caller has used its whole allowance of enrolment requests: 429 RATE_LIMITED with Retry-After, before the body is read (the code stays unspent).",
  "before": [
    {
      "limits.exhaust": "enroll"
    }
  ],
  "request": {
    "method": "POST",
    "path": "/v1/servers/enroll",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "pending-code-for-srv-c-0000000000000",
      "name": "build-1.example.test",
      "public_key": {
        "crv": "Ed25519",
        "kty": "OKP",
        "x": "NHeag29J2Xiwi2c44mZPGMwy4iqkMSHXAs3I7EdsKEc"
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": "60",
      "WWW-Authenticate": null
    },
    "body": {
      "error": {
        "code": "RATE_LIMITED",
        "message": "{{message}}"
      }
    }
  }
}
