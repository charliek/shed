{
  "name": "token-rate-limited",
  "description": "The caller has used its whole allowance of token requests: 429 temporarily_unavailable with Retry-After, before the assertion is read (it stays unspent).",
  "before": [
    {
      "limits.exhaust": "token"
    }
  ],
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 429,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": "60",
      "WWW-Authenticate": null
    },
    "body": {
      "error": "temporarily_unavailable",
      "error_description": "{{description}}"
    }
  }
}
