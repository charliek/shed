{
  "name": "token-replay-within-leeway",
  "description": "An assertion is accepted at the world's clock; the clock then moves past its exp but stays inside the 30-second leeway, where the assertion would still be in its window. Presented again, byte for byte, it is a replay: invalid_client. A fresh assertion with the same iat and exp, at the same instant, is then accepted: the window still admits it, so the refusal was for the replay alone. A service keeps each spent assertion at least until its exp plus the leeway.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{access_token}}",
      "expires_in": 600,
      "scope": "directory:read",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "before": [
        {
          "clock.set": "2026-11-16T06:01:15Z"
        }
      ],
      "assertion": {
        "reuse": true
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 401,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": "invalid_client",
          "error_description": "{{description}}"
        }
      }
    },
    {
      "assertion": {
        "key": "server-ed25519",
        "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
        "iat_offset": -75
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": "no-cache",
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "access_token": "{{access_token}}",
          "expires_in": 600,
          "scope": "directory:read",
          "token_type": "bearer"
        }
      }
    }
  ]
}
