{
  "name": "enroll-server-name-in-use",
  "description": "A code issued for a name a live server holds (srv-a): 409 SERVER_NAME_IN_USE, and the code stays unspent.",
  "request": {
    "method": "POST",
    "path": "/v1/servers/enroll",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "pending-code-for-srv-a-0000000000000",
      "name": "build-1.example.test",
      "public_key": {
        "crv": "Ed25519",
        "kty": "OKP",
        "x": "NHeag29J2Xiwi2c44mZPGMwy4iqkMSHXAs3I7EdsKEc"
      }
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": {
        "code": "SERVER_NAME_IN_USE",
        "message": "{{message}}"
      }
    }
  }
}
