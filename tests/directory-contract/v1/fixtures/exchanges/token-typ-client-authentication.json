{
  "name": "token-typ-client-authentication",
  "description": "The assertion's typ as a client sends it, client-authentication+jwt, then the same media type in another case with the application/ prefix, then no typ at all: each a fresh assertion, each accepted (rule 10).",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
    "typ": "client-authentication+jwt"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{access_token}}",
      "expires_in": 600,
      "scope": "directory:read",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "assertion": {
        "key": "server-ed25519",
        "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
        "typ": "Application/Client-Authentication+JWT"
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": "no-cache",
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "access_token": "{{access_token}}",
          "expires_in": 600,
          "scope": "directory:read",
          "token_type": "bearer"
        }
      }
    },
    {
      "assertion": {
        "key": "server-ed25519",
        "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a",
        "typ": null
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": "no-cache",
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "access_token": "{{access_token}}",
          "expires_in": 600,
          "scope": "directory:read",
          "token_type": "bearer"
        }
      }
    }
  ]
}
