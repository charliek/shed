{
  "name": "enroll-ok",
  "description": "A server enrols with a pending code (issued for the name srv-c) and a public key no server holds: 201 with its new client id, the issuer, the token endpoint and the organization; the code is spent. The server then logs in with an assertion its key signs for that client id.",
  "request": {
    "method": "POST",
    "path": "/v1/servers/enroll",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "pending-code-for-srv-c-0000000000000",
      "name": "build-1.example.test",
      "public_key": {
        "crv": "Ed25519",
        "kty": "OKP",
        "x": "NHeag29J2Xiwi2c44mZPGMwy4iqkMSHXAs3I7EdsKEc"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "client_id": "{{client_id}}",
      "contract": 1,
      "issuer": "https://accounts.example.test",
      "organization": "example",
      "token_endpoint": "https://accounts.example.test/oauth2/token"
    }
  },
  "then": [
    {
      "assertion": {
        "key": "enrol-ed25519",
        "client_id": "{{client_id}}"
      },
      "request": {
        "method": "POST",
        "path": "/oauth2/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": "no-cache",
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "access_token": "{{access_token}}",
          "expires_in": 600,
          "scope": "directory:read",
          "token_type": "bearer"
        }
      }
    }
  ]
}
