{
  "name": "directory-server-disabled",
  "description": "A live server (srv-a) gets a token; an operator then disables it; the directory refuses the token it still holds with 403 SERVER_DISABLED (the server's record is read on every request). A failed refresh: the server keeps its copy until its trust time ends, and logs loudly.",
  "assertion": {
    "key": "server-ed25519",
    "client_id": "srv_0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
  },
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials&client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&client_assertion={{assertion}}"
  },
  "response": {
    "status": 200,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": "no-cache",
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "access_token": "{{access_token}}",
      "expires_in": 600,
      "scope": "directory:read",
      "token_type": "bearer"
    }
  },
  "then": [
    {
      "before": [
        {
          "servers.disable": "srv-a"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/v1/directory",
        "headers": {
          "Authorization": "Bearer {{access_token}}"
        },
        "body": null
      },
      "response": {
        "status": 403,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "ETag": null,
          "Pragma": null,
          "Retry-After": null,
          "WWW-Authenticate": null
        },
        "body": {
          "error": {
            "code": "SERVER_DISABLED",
            "message": "{{message}}"
          }
        }
      }
    }
  ]
}
