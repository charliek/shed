{
  "name": "enroll-code-spent",
  "description": "A code already used (by srv-a's enrolment): 409 ENROLMENT_CODE_SPENT. After a lost answer this is the sign that the first enrolment committed.",
  "request": {
    "method": "POST",
    "path": "/v1/servers/enroll",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "spent-code-of-srv-a-0000000000000000",
      "name": "build-1.example.test",
      "public_key": {
        "crv": "Ed25519",
        "kty": "OKP",
        "x": "NHeag29J2Xiwi2c44mZPGMwy4iqkMSHXAs3I7EdsKEc"
      }
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "Cache-Control": "no-store",
      "Content-Type": "application/json",
      "ETag": null,
      "Pragma": null,
      "Retry-After": null,
      "WWW-Authenticate": null
    },
    "body": {
      "error": {
        "code": "ENROLMENT_CODE_SPENT",
        "message": "{{message}}"
      }
    }
  }
}
