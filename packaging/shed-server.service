[Unit]
Description=Shed Development Environment Server
# network-online.target: a server that takes its users from an account service
# pulls the list at start-up, and a remote-backend server calls its cloud
# provider; before the network is online both fail. This file is a dpkg
# conffile: an edited copy makes the upgrade that changes it prompt
# (scripts/release/test-deb-upgrade.sh, rows T11-T13).
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/shed-server serve --config /etc/shed/server.yaml
# Optional (the leading "-"): environment variables for shed-server, such as
# the cloud settings a remote-backend server reads from the variables its
# server.yaml names (docs/reference/remote-backend.md). The file can hold
# credentials: keep it owned by root with mode 0600. The package ships none.
EnvironmentFile=-/etc/shed/server.env
# #372: only shed-server itself gets the stop signal; each shed's
# firecracker VMM stays up and is re-attached by the resume walk (#315)
# when the server comes back.
KillMode=process
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
RuntimeDirectory=shed/firecracker
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
