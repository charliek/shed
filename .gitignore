vendor/

# IDE and editor
.idea/
.vscode/
.claude/settings.local.json
.claude/scheduled_tasks.lock
*.swp
*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
# Exception: the committed, throwaway self-signed TLS pair the broker wire harness
# serves for the secure-bus cells (non-secret; Python `ssl` can't generate one at runtime,
# so a fixed pair is committed for a stable leaf-DER pin). See tests/broker-wire/README.
!tests/broker-wire/fixtures/synthetic_bus_cert.pem
!tests/broker-wire/fixtures/synthetic_bus_key.pem
# Exception: the directory contract's throwaway test keys (non-secret; made for the
# fixtures and listed in its manifest). See tests/directory-contract/README.md.
!tests/directory-contract/v1/fixtures/test-keys/*.pem
# Exception: the certificate user fixtures (certificates only, no private keys; written
# by a Go test in internal/servertls). See crates/fixtures/clientuser/README.md.
!crates/fixtures/clientuser/*.pem

# Desktop app local secrets (Sparkle private key, notarization creds)
desktop/.secrets/

# Files below are git-ignored AND synced across machines via envsecrets
# (age-encrypted to GCS). Do not remove or modify the "# envsecrets" marker line;
# everything between it and the next blank line is the tracked-file list.
# envsecrets
desktop/.secrets/cert.p12
desktop/.secrets/apple.env

# Local configuration (keep examples)
server.yaml
!configs/server.example.yaml
!configs/server.dev.yaml

# Logs
*.log
/tmp/

# Debug files
__debug_bin*

# OS generated files
Thumbs.db
ehthumbs.db

# Packaging build artifacts
packaging/server.yaml.generated

# Rust / desktop build artifacts (imported workspaces)
crates/target/
desktop/artifacts/
# …but the Go `bin/` ignore above must not swallow Rust `src/bin/` crates:
!crates/**/src/bin/
# desktop app launcher-script resources (also swallowed by the unanchored bin/ rule)
!desktop/Resources/bin/

# Documentation build
site-build/

# Zensical differential-build cache (root only -- the anchor keeps this from
# also swallowing a nested .cache/ elsewhere in the tree)
/.cache/
.venv/
# NOTE: the root lockfile IS committed. The docs group carries a git
# dependency (stridelabs-docs-theme, pinned by tag); tags are mutable, so the
# lockfile's resolved commit SHA is the only integrity check there is, and CI
# builds docs with `uv sync --locked`. Same reproducibility rationale as the
# three lockfiles already committed below.
# The integration test suite's lockfile is committed for reproducibility:
!tests/integration/uv.lock
# … and the desktop workspace's lockfile is committed too:
!desktop/uv.lock
# … and the broker wire harness's lockfile is committed too:
!tests/broker-wire/uv.lock
# Python tooling caches for the integration suite
tests/integration/.pytest_cache/
tests/broker-wire/.pytest_cache/
**/__pycache__/
