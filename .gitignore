vz/shed-ext-aws-credentials
vz/docker-credential-shed
vz/shed-ext-rc
vz/ext-etc/
firecracker/shed-ext-ssh-agent
firecracker/shed-ext-aws-credentials
firecracker/docker-credential-shed
firecracker/shed-ext-rc
firecracker/ext-etc/
*.exe
*.exe~
*.dll
*.so
*.dylib

