*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
# Exception: the committed, throwaway self-signed TLS pair the host-agent-diff harness
# serves for the secure-bus cells (non-secret; Python `ssl` can't generate one at runtime,
# so a fixed pair is committed for a stable leaf-DER pin). See tests/host-agent-diff/README.
!tests/host-agent-diff/fixtures/synthetic_bus_cert.pem
!tests/host-agent-diff/fixtures/synthetic_bus_key.pem

# Desktop app local secrets (Sparkle private key, notarization creds)
desktop/.secrets/

# Files below are git-ignored AND synced across machines via envsecrets
# (age-encrypted to GCS). Do not remove or modify the "# envsecrets" marker line;
# everything between it and the next blank line is the tracked-file list.
# envsecrets
desktop/.secrets/cert.p12
desktop/.secrets/apple.env

# Local configuration (keep examples)
server.yaml
!configs/server.example.yaml
!configs/server.dev.yaml

# Logs
*.log
/tmp/

# Debug files
__debug_bin*

# OS generated files
Thumbs.db
ehthumbs.db

# Packaging build artifacts
packaging/server.yaml.generated

# Rust / desktop build artifacts (imported workspaces)
crates/target/
desktop/artifacts/
# …but the Go `bin/` ignore above must not swallow Rust `src/bin/` crates:
!crates/**/src/bin/
# desktop app launcher-script resources (also swallowed by the unanchored bin/ rule)
!desktop/Resources/bin/

# Documentation build
site-build/
.venv/
uv.lock
# … but the integration test suite's lockfile is committed for reproducibility:
!tests/integration/uv.lock
# … and the desktop workspace's lockfile is committed too:
!desktop/uv.lock
# … and the host-agent differential harness's lockfile is committed too:
!tests/host-agent-diff/uv.lock
# Python tooling caches for the integration suite
tests/integration/.pytest_cache/
tests/host-agent-diff/.pytest_cache/
**/__pycache__/
